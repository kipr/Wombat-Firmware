{
  "name": "Wombat Firmware Dev",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../",
    "target": "devcontainer"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools-extension-pack",
        "github.vscode-pull-request-github",
        "openai.chatgpt"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "fish",
        "terminal.integrated.profiles.linux": {
          "fish": {
            "path": "/usr/bin/fish"
          }
        }
      }
    }
  },
  "initializeCommand": "mkdir -p \"$HOME/.config/codex\"",
  "mounts": [
    "source=${localEnv:HOME}/.config/codex,target=/home/ubuntu/.codex,type=bind,consistency=cached"
  ],
  "remoteUser": "1000"
}
